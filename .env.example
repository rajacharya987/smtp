# Copy to /etc/mailgate/secrets/env or export before running in development.
# Never commit real values.

MAILGATE_CONFIG=/etc/mailgate/config.yml
MAILGATE_SECRETS_DIR=/etc/mailgate/secrets
MAILGATE_DATA_DIR=/var/lib/mailgate
MAILGATE_LOG_DIR=/var/log/mailgate

# Development only
MAILGATE_DEV=0
MAILGATE_CORS_ORIGINS=http://localhost:3000
MAILGATE_DATABASE_URL=postgresql://mailgate:CHANGE_ME@127.0.0.1:5432/mailgate
MAILGATE_SECURE_COOKIES=1
